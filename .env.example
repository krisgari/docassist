# Copy to .env and fill in. Everything works without keys (mock LLM + local embeddings),
# so the demo and the eval suite run offline; add a key to see the real agent.

# Claude (agent loop + synthesis). Empty = deterministic extractive "mock" mode.
ANTHROPIC_API_KEY=
# auto = anthropic if a key is set, otherwise mock. Options: auto | anthropic | mock
DOCASSIST_LLM_PROVIDER=auto
DOCASSIST_LLM_MODEL=claude-sonnet-5-5
DOCASSIST_LLM_FAST_MODEL=claude-haiku-5-5

# Who orchestrates the agent: langgraph (Python service in ./agent) | java (in-process loop)
DOCASSIST_ORCHESTRATOR=langgraph
# Shared secret between query-api and the agent service (service-to-service auth)
DOCASSIST_INTERNAL_TOKEN=dev-internal-token-change-me

# Embeddings: local (feature hashing, no network, fine for the demo corpus) | voyage
DOCASSIST_EMBEDDINGS_PROVIDER=local
VOYAGE_API_KEY=

# Signs demo JWTs. In production, replace with your IdP (Okta / Entra) issuer — see README.
DOCASSIST_JWT_SECRET=change-me-local-dev-secret-at-least-32-bytes!!
