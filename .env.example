# Copy to .env and fill in. Everything works without keys (mock model + local embeddings),
# so the demo and the eval suite run offline; add a key to see the real agent.

# Claude (LangGraph agent in the query plane; summaries in the ingestion plane's job worker).
# Empty = deterministic extractive "mock" mode.
ANTHROPIC_API_KEY=
# auto = anthropic if a key is set, otherwise mock. Options: auto | anthropic | mock
DOCASSIST_LLM_PROVIDER=auto
DOCASSIST_LLM_MODEL=claude-sonnet-5-5
DOCASSIST_LLM_FAST_MODEL=claude-haiku-5-5

# Embeddings must be the same on both planes: local (bit-exact hashing, offline) | voyage
DOCASSIST_EMBEDDINGS_PROVIDER=local
VOYAGE_API_KEY=

# Conversation memory for the LangGraph agent: postgres (checkpointer) | off
DOCASSIST_CHECKPOINTER=postgres

# Signs demo JWTs. In production, verify your IdP's tokens instead (Okta / Entra) — see README.
DOCASSIST_JWT_SECRET=change-me-local-dev-secret-at-least-32-bytes!!

# Tracing (optional). Start Jaeger with `docker compose --profile observability up -d jaeger`, then:
OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
# LangSmith tracing of each LangGraph run (optional):
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=

# Host ports, if 5432 / 6379 are already taken on your machine
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
